# Young Lists is a static app with no build step, so there is very little to
# ignore. Note that young-lists/config.js IS committed on purpose: it holds the
# Supabase project URL and the publishable key, both of which are meant to be
# visible in the browser. Privileged keys must never be put in this repository
# at all — see SECURITY.md.

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
.cache/

# Only present if someone adds tooling later
node_modules/
dist/
build/
.env
.env.local
.env.*.local

# Local test artefacts
/var/tmp/yl-pgdata/
